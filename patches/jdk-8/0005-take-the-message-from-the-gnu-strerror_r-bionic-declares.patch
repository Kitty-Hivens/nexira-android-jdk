Subject: [PATCH] nexira: take the message from the GNU strerror_r bionic declares

---
diff --git a/jdk/src/solaris/native/common/jni_util_md.c b/jdk/src/solaris/native/common/jni_util_md.c
index 24c72382..0007369a 100644
--- a/jdk/src/solaris/native/common/jni_util_md.c
+++ b/jdk/src/solaris/native/common/jni_util_md.c
@@ -72,5 +72,17 @@ int
 getErrorString(int err, char *buf, size_t len)
 {
     if (err == 0 || len < 1) return 0;
+#ifdef __ANDROID__
+    /* With _GNU_SOURCE bionic declares the variant that returns the message, which may not be in buf. */
+    {
+        const char *msg = strerror_r(err, buf, len);
+        if (msg != buf) {
+            strncpy(buf, msg, len - 1);
+            buf[len - 1] = '\0';
+        }
+        return 0;
+    }
+#else
     return strerror_r(err, buf, len);
+#endif
 }
