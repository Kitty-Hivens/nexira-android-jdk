Subject: [PATCH] nexira: hide the mark word value from alignment assumptions

clang takes the this pointer of a class derived from oopDesc to be eight byte aligned and folds the tests of the low lock bits of a mark word to a constant, so every mark looked stack locked and the VM dereferenced a neutral one while inflating a monitor.

---
diff --git a/hotspot/src/share/vm/oops/markOop.hpp b/hotspot/src/share/vm/oops/markOop.hpp
index 649217c8..798f72b0 100644
--- a/hotspot/src/share/vm/oops/markOop.hpp
+++ b/hotspot/src/share/vm/oops/markOop.hpp
@@ -104,7 +104,16 @@ class JavaThread;
 class markOopDesc: public oopDesc {
  private:
   // Conversion
-  uintptr_t value() const { return (uintptr_t) this; }
+  // The mark word is the pointer itself, so the bits of `this` are what it holds. A compiler that takes
+  // `this` to carry the alignment of the class folds the tests of its low bits away, so the value goes
+  // through an empty assembler statement it cannot see through.
+  uintptr_t value() const {
+    uintptr_t v = (uintptr_t) this;
+#if defined(__clang__)
+    __asm__("" : "+r"(v));
+#endif
+    return v;
+  }
 
  public:
   // Constants
